<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_upcoming" android:textColor="#9AA0AE" android:textSize="12sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_n1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_a1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_n2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_a2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_n3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_a3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F3F4F6" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
